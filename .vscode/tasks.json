// The extension host loads src/extension.ts directly (Node's native TypeScript
// type stripping, package.json "type": "module") — no build step for it.
// The webview still runs in a browser context that cannot execute TypeScript,
// so it's the only thing that needs bundling before launch.
{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "build:webview",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$esbuild-watch",
      "label": "npm: build:webview",
      "presentation": {
        "reveal": "silent"
      }
    }
  ]
}

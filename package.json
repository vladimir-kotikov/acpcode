{
  "name": "acpcode",
  "displayName": "acpcode",
  "description": "Yet another ACP-based agentic chat",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.145.0"
  },
  "publisher": "vlkoti",
  "repository": "https://github.com/vladimir.kotikov/acpcode.git",
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "type": "module",
  "activationEvents": [
    "onWebviewPanel:acpcode.sessionViewEditor",
    "onStartupFinished"
  ],
  "main": "./src/extension.ts",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "acpcode",
          "title": "ACP Code",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "acpcode": [
        {
          "id": "acpcode.sessions",
          "name": "Sessions",
          "type": "tree"
        },
        {
          "id": "acpcode.sessionView",
          "name": "Session",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "acpcode.addAgent",
        "title": "Add Agent",
        "category": "ACP Code",
        "icon": "$(person-add)"
      },
      {
        "command": "acpcode.editAgentsConfig",
        "title": "Edit Agents Config",
        "category": "ACP Code",
        "icon": "$(gear)"
      },
      {
        "command": "acpcode.refreshSessions",
        "title": "Refresh Sessions",
        "category": "ACP Code",
        "icon": "$(refresh)"
      },
      {
        "command": "acpcode.toggleGroupSessionsByCwd",
        "title": "Toggle Grouping Sessions by Directory",
        "category": "ACP Code"
      },
      {
        "command": "acpcode.openSessionInEditor",
        "title": "Open Session in Editor",
        "category": "ACP Code",
        "icon": "$(link-external)"
      },
      {
        "command": "acpcode.openTreeSessionInEditor",
        "title": "Open Session in Editor",
        "category": "ACP Code",
        "icon": "$(link-external)"
      },
      {
        "command": "acpcode.deleteSession",
        "title": "Delete Session",
        "category": "ACP Code",
        "icon": "$(trash)"
      },
      {
        "command": "acpcode.newSession",
        "title": "New Session",
        "category": "ACP Code",
        "icon": "$(add)"
      },
      {
        "command": "acpcode.attachFileToChat",
        "title": "Attach to ACP Code Chat",
        "category": "ACP Code"
      },
      {
        "command": "acpcode.connectChatToAgentHost",
        "title": "Connect VS Code Chat to ACP Agents",
        "category": "ACP Code"
      },
      {
        "command": "acpcode.restartAgentHost",
        "title": "Restart Agent Host",
        "category": "ACP Code"
      },
      {
        "command": "acpcode.showAgentHostLog",
        "title": "Show Agent Host Log",
        "category": "ACP Code"
      },
      {
        "command": "acpcode.updateBridges",
        "title": "Update Agent Bridges",
        "category": "ACP Code"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "acpcode.addAgent",
          "when": "view == acpcode.sessions",
          "group": "navigation"
        },
        {
          "command": "acpcode.editAgentsConfig",
          "when": "view == acpcode.sessions",
          "group": "navigation"
        },
        {
          "command": "acpcode.refreshSessions",
          "when": "view == acpcode.sessions",
          "group": "navigation"
        },
        {
          "command": "acpcode.openSessionInEditor",
          "when": "view == acpcode.sessionView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "acpcode.openTreeSessionInEditor",
          "when": "view == acpcode.sessions && viewItem == acpcode.session",
          "group": "inline"
        },
        {
          "command": "acpcode.openTreeSessionInEditor",
          "when": "view == acpcode.sessions && viewItem == acpcode.session",
          "group": "9_acpcode"
        },
        {
          "command": "acpcode.deleteSession",
          "when": "view == acpcode.sessions && viewItem == acpcode.session",
          "group": "inline"
        },
        {
          "command": "acpcode.deleteSession",
          "when": "view == acpcode.sessions && viewItem == acpcode.session",
          "group": "9_acpcode"
        },
        {
          "command": "acpcode.newSession",
          "when": "view == acpcode.sessions && viewItem == acpcode.cwdGroup",
          "group": "inline"
        },
        {
          "command": "acpcode.newSession",
          "when": "view == acpcode.sessions && viewItem == acpcode.cwdGroup",
          "group": "9_acpcode"
        },
        {
          "command": "acpcode.newSession",
          "when": "view == acpcode.sessions && viewItem == acpcode.agent",
          "group": "inline"
        },
        {
          "command": "acpcode.newSession",
          "when": "view == acpcode.sessions && viewItem == acpcode.agent",
          "group": "9_acpcode"
        }
      ],
      "explorer/context": [
        {
          "command": "acpcode.attachFileToChat",
          "group": "9_acpcode"
        }
      ],
      "editor/title/context": [
        {
          "command": "acpcode.attachFileToChat",
          "group": "9_acpcode"
        }
      ]
    },
    "configuration": {
      "title": "ACP Code",
      "properties": {
        "acpcode.agents": {
          "type": "array",
          "description": "Configured agents shown in the Sessions view, e.g. Claude profiles mirroring shell aliases like `claude-personal='CLAUDE_CONFIG_DIR=~/.claude-personal claude'`.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "kind"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name for this agent. Must be unique."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "claude",
                  "codex"
                ],
                "description": "Which ACP agent implementation to spawn."
              },
              "env": {
                "type": "object",
                "description": "Extra environment variables to set when spawning this agent, e.g. CLAUDE_CONFIG_DIR.",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {}
              }
            }
          },
          "default": [
            {
              "name": "Claude",
              "kind": "claude",
              "env": {}
            },
            {
              "name": "Claude (personal)",
              "kind": "claude",
              "env": {
                "CLAUDE_CONFIG_DIR": "~/.claude-personal"
              }
            }
          ]
        },
        "acpcode.groupSessionsByCwd": {
          "type": "boolean",
          "default": false,
          "description": "Group each agent's sessions by their working directory in the Sessions view."
        },
        "acpcode.agentHost.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Serve the configured agents over the Agent Host Protocol so VS Code's native Chat can use them (VS Code 1.145+). Run **ACP Code: Connect VS Code Chat to ACP Agents** in a workspace to point Chat at it. Requires a window reload."
        },
        "acpcode.agentHost.filterSessionsByWorkspace": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "List only the sessions whose directory is a workspace folder of an open VS Code window. Off lists every session the agents know about, like the Claude agents UI. Takes effect when Chat next connects."
        },
        "acpcode.agentHost.releaseSessionsAfter": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "markdownDescription": "Seconds a session stays loaded after Chat stops showing it. Then the agent host closes it, so a terminal or the Claude agents UI can continue it; opening it in Chat again loads it again. A session still running a turn closes once it's done."
        },
        "acpcode.agentHost.port": {
          "type": "number",
          "markdownDescription": "Local port (127.0.0.1) the agent host listens on. Defaults to 8765 (8766 in VS Code Insiders, so both can run side by side). Requires a window reload."
        },
        "acpcode.bridgeVersions": {
          "type": "object",
          "markdownDescription": "npm version (or range, or dist-tag) of each agent's ACP bridge to install instead of the latest release, e.g. `{ \"claude\": \"0.93.0\" }`. Changing it installs that version. Without a pin, bridges only update through **ACP Code: Update Agent Bridges**.",
          "properties": {
            "claude": {
              "type": "string",
              "description": "@agentclientprotocol/claude-agent-acp version"
            },
            "codex": {
              "type": "string",
              "description": "@agentclientprotocol/codex-acp version"
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      }
    }
  },
  "scripts": {
    "build": "npm run check-types && npm run lint && npm run build:webview",
    "build:webview": "node esbuild.cjs",
    "package": "npm run check-types && npm run lint && node esbuild.cjs --production",
    "test": "node --test \"src/**/*.test.ts\"",
    "check-types": "tsc --noEmit",
    "lint": "prettier . --write && eslint src --fix && tsc --noEmit",
    "vscode:prepublish": "npm run package",
    "watch": "npm-run-all -p watch:*",
    "watch:webview": "node esbuild.cjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@microsoft/agent-host-protocol": "^1.0.0",
    "diff": "^8.0.4",
    "ts-pattern": "^5.9.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.145.0",
    "@types/ws": "^8.18.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "highlight.js": "^11.12.0",
    "htm": "^3.1.1",
    "marked": "^18.1.3",
    "npm-run-all": "^4.1.5",
    "preact": "^10.29.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "prettier": {
    "arrowParens": "avoid"
  }
}
